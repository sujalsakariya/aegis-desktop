# Backend API origin. The backend must be running separately.
LICENSE_API_URL="http://localhost:3001"

# Base64-encoded Ed25519 public keys only.
# Never place a private signing key in this project.
# These are injected into the Electron main bundle at BUILD time, so a rebuild
# is required after changing them. Leaving them empty makes every licence and
# definition signature check fail closed.
LICENSE_PUBLIC_KEY="base64-encoded-PEM-public-key"
DEFINITION_SIGNING_PUBLIC_KEY="base64-encoded-PEM-public-key"

# Optional. Defaults to the version in package.json. Application update checks
# treat any published release newer than this as an available update.
MIN_APP_VERSION=""
